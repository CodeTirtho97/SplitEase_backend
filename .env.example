PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET=<generate-a-long-random-hex-string>

GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
BACKEND_GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

FRONTEND_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

EMAIL_USER=<smtp-email-address>
EMAIL_PASS=<smtp-app-password>

REDIS_URL=rediss://<username>:<password>@<host>:<port>

EXCHANGERATES_API_KEY=<exchangerates-api-key>
EXCHANGE_RATE_URL=https://api.exchangerates-api.io/v1/latest
BASE_CURRENCY=INR
